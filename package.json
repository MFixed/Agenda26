{
  "name": "agenda26-v2",
  "version": "2.0.0",
  "description": "Agenda26 v2 - Gestion de citas y tareas multi-empresa (SQLite)",
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "prestart": "node scripts/verificar-entorno.js",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:reset": "node prisma/reset.js",
    "db:setup": "node prisma/setup.js",
    "db:seed": "node prisma/seed.js",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:backup": "node prisma/backup.js",
    "email:probar": "node scripts/probar-correo.js",
    "test": "node --import ./tests/setup.js --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "test:watch": "node --import ./tests/setup.js --test --watch --test-concurrency=1 \"tests/**/*.test.js\"",
    "test:coverage": "node --import ./tests/setup.js --test --test-concurrency=1 --experimental-test-coverage \"tests/**/*.test.js\"",
    "smoke": "node scripts/smoke.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.1.0",
    "prisma": "^6.19.3",
    "resend": "^6.32.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "eslint": "^9.17.0",
    "prettier": "^3.4.2"
  }
}

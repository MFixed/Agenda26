{
  "name": "gestion-tareas-clientes-citas",
  "version": "1.0.0",
  "private": true,
  "description": "Gestión de tareas, clientes, disponibilidad y citas · Express + Prisma + SQLite",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:seed": "node prisma/seed.js",
    "db:reset": "prisma migrate reset",
    "reset": "node scripts/limpiar.js",
    "simular": "node scripts/simulacion.js",
    "estado": "node scripts/estado.js",
    "test": "node --test \"test/**/*.test.js\"",
    "check:imports": "node scripts/comprobar-imports.mjs",
    "escenario": "node scripts/escenario.js"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "prisma": "6.19.3"
  }
}

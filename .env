# Base de datos local. NO se sube al repositorio (está en el .gitignore).
#
# Ahora la base es PostgreSQL, no SQLite: Prisma sólo acepta `mode:
# "insensitive"` en PostgreSQL, y la búsqueda de clientes lo usa.
#
# Los dos parámetros del final no son opcionales:
#   sslmode=require      Render exige TLS
#   connection_limit=1   el plan gratuito limita las conexiones y Prisma abre
#                        un pool por defecto que las agota

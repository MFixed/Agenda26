# Puerto del servidor
PORT=3000
NODE_ENV=development

# ---------------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------------
#
# PostgreSQL. El motor lo deduce Prisma de `prisma/schema.prisma`, que declara
# `provider = "postgresql"`: un `file:` NO funciona, Prisma lo rechaza al conectar.
#
# En desarrollo puedes apuntar a la misma base de Render que en produccion, o a un
# PostgreSQL local. Lo que NO se puede es una URL `file:`.
#
# En Render esta variable se pone en el panel (Environment), no en un fichero .env:
# la cadena de conexion lleva la contrasena y no se versiona nunca.
#
# Opcional: `?schema=otro` si las tablas van en un esquema distinto de `public`.
# `config/driver.js` usa `current_schema()` para las comprobaciones de arranque, asi
# que lo respeta automaticamente.
#
# Para empezar de cero y quedar con solo el superadministrador: `npm run db:setup`.
DATABASE_URL="postgresql://usuario:contrasena@host:5432/agenda26?schema=public"

# ---------------------------------------------------------------------------
# Autenticacion
# ---------------------------------------------------------------------------
#
# OBLIGATORIA. Minimo 32 caracteres, o el servidor no arranca.
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-este-valor-por-uno-aleatorio-de-48-caracteres

# Access token corto: 15 minutos. Se renueva solo con POST /api/auth/refresh, sin
# que el usuario tenga que volver a entrar.
JWT_EXPIRES_IN=15m
JWT_ISSUER=agenda26
JWT_AUDIENCE=agenda26-app

# Refresh token: 30 dias, guardado HASHEADO en la base y revocable. Es lo que hace
# que un panel abierto toda la tarde no expulse a nadie a las 8 horas.
REFRESH_EXPIRES_DAYS=30

# Minutos que dura el enlace de "olvide mi contrasena".
PASSWORD_RESET_EXPIRES_MIN=30

# ---------------------------------------------------------------------------
# Superadministrador de plataforma (`npm run db:setup` / `npm run db:reset`)
# ---------------------------------------------------------------------------
#
# La cuenta que gestiona las empresas de la plataforma. NO pertenece a ninguna
# empresa y es la unica que puede crear otras.
#
# OBLIGATORIA en produccion: sin ella estos scripts no se ejecutan. Antes la
# contrasena estaba fija en el codigo (`Super1234`) y se imprimia por pantalla, con
# lo que un despliegue desde CI dejaba la contrasa de la cuenta mas poderosa del
# sistema en un log archivado.
#
# Si se deja vacia en DESARROLLO, se genera una aleatoria y se imprime una sola vez.
#
# OJO: en produccion cambiare esta en el primer acceso. Es la cuenta con mas poder
# del sistema.
SUPERADMIN_PASSWORD=
SUPERADMIN_EMAIL=super@plataforma.com

# Cuanto se espera a que terminen las conexiones abiertas antes de forzar el cierre.
SHUTDOWN_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# Correo (opcional)
# ---------------------------------------------------------------------------
#
# Hay DOS formas de enviarlo y solo se usa UNA: la que diga `MAIL_DRIVER`.
#
#   resend -> la API de Resend (recomendado en produccion, 3.000/mes gratis)
#   smtp   -> cualquier servidor de correo: Gmail, Outlook, Brevo, Mailjet...
#   ninguno-> no sale correo; los avisos quedan como notificacion dentro del panel
#
# Si no lo pones, se deduce: hay RESEND_API_KEY -> resend; hay SMTP_HOST -> smtp.
#
# Sin ninguna de las dos la API arranca igual, solo que no manda correo.
MAIL_DRIVER=ninguno

# --- Opcion A: Resend ---
#
# La mas comoda en produccion: no hay que mantener nada y los correos salen firmados
# (DKIM/DMARC) de origen, que es lo que evita que acaben en la carpeta de spam.
# Plan gratis: 3.000 correos al mes y 100 al dia. Crear la clave en resend.com.
RESEND_API_KEY=

# --- Opcion B: SMTP (Gmail y otros) ---
#
# OJO con Gmail: NO vale la contrasena normal de tu cuenta. Hay que generar una
# "contrasena de aplicacion" (16 caracteres) en la seguridad de la cuenta, con la
# verificacion en dos pasos puesta. Ademas Gmail pone limites de envio y puede
# bloquear la cuenta si detecta envios masivos o volumen raro. Para produccion
# pequena va bien; para mucho volumen, mejor un servicio de correo de verdad.
SMTP_HOST=
SMTP_PORT=587
# `false` para el 587 (sube a cifrado con STARTTLS). `true` para el 465 (cifrado directo).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Remitente: lo que ve el cliente en la bandeja de entrada.
EMAIL_FROM="Agenda26 <agenda@ejemplo.com>"

# Solo desarrollo: manda los avisos a esta direccion en vez de al cliente, para poder
# verlos sin entregar nada a un cliente de verdad. En produccion se ignora aunque este
# puesta (es lo que evita mandar a un cliente real un correo de prueba).
EMAIL_TEST_DESTINO=tu-correo-de-prueba@ejemplo.com

# Base publica: la usan los enlaces del correo y del .ics.
#
# OBLIGATORIA en produccion (la app no arranca sin ella) y con HTTPS: es la direccion
# que aparece en los enlaces de recuperar contrasena, confirmar cita y descargar el
# calendario. Si aqui queda `localhost`, esos correos llegan con enlaces inservibles.
APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Red y cabeceras
# ---------------------------------------------------------------------------
#
# Origenes que pueden llamar a la API desde un navegador, separados por comas.
#
# En produccion NO puede quedar en `*`: con el comodin cualquier sitio puede llamar a
# la API, y la app se niega a arrancar si lo encuentra. Como el frontend se sirve
# desde el mismo Express, normalmente basta con el dominio publico de la app.
CORS_ORIGIN=*

# Nivel de log: error | warn | info | debug | trace.
# Sin ponerlo, en produccion es `info` y en desarrollo `debug`.
#
# El formato NO se configura: produccion emite JSON (una linea, indexable) y
# desarrollo texto legible. Es automatico.
LOG_LEVEL=debug

# Cuantos proxies hay delante: el numero de saltos, o `true` si son de confianza.
#
# DESACTIVADO por defecto, y hay que dejarlo asi salvo que sepas lo que se hace: con
# `true`, Express toma la IP del cliente de la cabecera `X-Forwarded-For` que este
# mande, y un atacante que la cambie en cada peticion recibe un cubo de limite
# LIMPIO en cada una (los limites de login y de registro dejan de existir).
#
# Detras de nginx o de un balanceador: `TRUST_PROXY=1`.
# Con Node exposed directamente: dejarlo sin poner.
# TRUST_PROXY=1

# ---------------------------------------------------------------------------
# Limites de peticiones
# ---------------------------------------------------------------------------
#
# En memoria, sin Redis. Con una sola instancia da igual que Redis; con varias, el
# tope real es limite x instancias.
# Con RATE_LIMIT_ENABLED=false se apagan todos (lo usan las pruebas automaticas).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MINUTES=15

# Intentos FALLIDOS de login por IP+email. Los accesos correctos no gastan cupo: un
# usuario normal no se bloquea a si mismo.
LOGIN_RATE_LIMIT_MAX=15

# Peticiones de recuperacion de contrasena. Mas bajo que el login porque cada una
# dispara un correo real.
FORGOT_RATE_LIMIT_MAX=5

# Altas de cuenta, por IP y contando TODAS las peticiones (no solo las fallidas).
#
# Va aparte del limite de login a proposito: aquel cuenta por `IP+email`, asi que un
# atacante con cuentas de correo distintas recibia un cubo vacio en cada peticion y
# podia crear cuentas en masa sin toparse nunca. Este va solo por IP.
REGISTER_RATE_LIMIT_MAX=10

# ---------------------------------------------------------------------------
# Documentacion
# ---------------------------------------------------------------------------
#
# Swagger UI en /api/docs. NO pide autenticacion y esta exenta del rate limit, asi que
# publica el contrato completo de la API a quien pase por ahi.
#
# En produccion sale APAGADO salvo que se ponga aqui de forma explicita. En
# desarrollo se puede dejar encendido.
DOCS_ENABLED=true

# ---------------------------------------------------------------------------
# Cabeceras de seguridad
# ---------------------------------------------------------------------------
#
# La CSP va laxa porque el frontend lleva scripts embebidos y estilos en linea.
CSP_ENABLED=true

# ---------------------------------------------------------------------------
# Tareas en segundo plano
# ---------------------------------------------------------------------------
#
# Nada se ejecuta solo sin esto: retenciones caducadas, recordatorios y purgas.
#
# Con MAS DE UNA instancia hay que dejarlo en `true` SOLO en una: las demas con
# `JOBS_ENABLED=false`. Si dos instancias corren el worker a la vez, las dos
# envian los mismos correos de recordatorio y los clientes los reciben duplicados.
JOBS_ENABLED=true

# Cada cuanto despierta el planificador. El primer paso es inmediato.
# Minimo 1000: por debajo el worker se solapa consigo mismo.
JOB_INTERVAL_MS=60000

# Minutos que un hueco queda retenido (HELD) mientras el cliente completa la
# reserva. El valor por defecto esta en los ajustes del negocio, que ganan a este.
HOLD_MINUTES=10

# Dias que se guardan las notificaciones leidas antes de purgarlas.
NOTIFICATION_RETENTION_DAYS=90

REMINDERS_ENABLED=true

# ---------------------------------------------------------------------------
# SQLite (avanzado)
# ---------------------------------------------------------------------------
#
# SIN EFECTO CON EL ESQUEMA ACTUAL: `schema.prisma` declara `provider =
# "postgresql"`, asi que `configurarSqlite()` sale antes de tocar nada y estas dos
# variables no se leen. Se dejan documentadas por si algun dia se vuelve a SQLite.
# En PostgreSQL los equivalentos no hacen falta: las claves foraneas estan siempre
# activas y el pool de conexiones ya gestiona la concurrencia.
#
# Cuando se espera a un bloqueo antes de fallar. Con `busy_timeout=0` (el valor por
# defecto de SQLite) la segunda escritura que llega mientras hay una en curso falla
# al instante con SQLITE_BUSY en vez de esperar.
SQLITE_BUSY_TIMEOUT_MS=5000

# Cuando se vuelca a disco. FULL hace un fsync en cada escritura: es lo que permite
# decir que lo que se contesto esta escrito, y evita perder la ultima transaccion si
# la maquina se apaga de golpe. En produccion es FULL por defecto.
#
# Valores validos: OFF | NORMAL | FULL | EXTRA.
# Poner NORMAL en produccion saves unos milisegundos por escritura y pierdes la
# ultima transaccion confirmada en un corte de corriente.
SQLITE_SYNCHRONOUS=
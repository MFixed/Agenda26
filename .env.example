# Puerto del servidor
PORT=3000

# Secreto para firmar los JWT. Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-este-valor-por-uno-aleatorio
JWT_EXPIRES_IN=8h

# Conexion a PostgreSQL
DATABASE_URL="postgresql://usuario:password@localhost:5432/citas?schema=public"

# Aviso por correo al cliente cuando una cita pasa a COORDINATED (resend.com).
# Opcional: sin RESEND_API_KEY la API arranca igual y no se manda correo, solo
# queda la notificacion interna del panel.
RESEND_API_KEY=
# Remitente. Debe ser un dominio verificado en resend.com. Para una prueba
# suelta se puede usar "Agenda26 <onboarding@resend.dev>", que solo deja
# enviar al correo del titular de la cuenta.
EMAIL_FROM="Agenda26 <onboarding@resend.dev>"
# Solo desarrollo. Redirige los avisos a esta direccion en vez de mandarlos al
# cliente, para poder ver el correo y el .ics completos mientras se prueba con
# el remitente de prueba. Con NODE_ENV=production se ignora aunque este puesta:
# ahi cada aviso va a su destinatario real.
EMAIL_TEST_DESTINO=tu-correo-de-prueba@ejemplo.com
# Base publica de la aplicacion: el correo la usa para apuntar al panel.
APP_URL=http://localhost:3000

# Cabeceras CORS. Orígenes que pueden llamar a la API desde un navegador,
# separados por comas. * (por defecto) acepta cualquiera: comodo mientras se
# desarrolla, y lo que no se debe dejar en produccion. Con el frontend servido
# desde el mismo Express CORS solo importa si el panel se abre desde otro host
# (un Vite en desarrollo, un dominio aparte en produccion).
# CORS_ORIGIN=http://localhost:5173,https://app.ejemplo.com

# Log de peticiones (morgan): dev, combined, short, tiny, common o none.
# Por defecto dev en desarrollo y combined con NODE_ENV=production.
# LOG_FORMAT=dev

# Documentacion interactiva de la API en /api/docs. Con DOCS_ENABLED=false no
# se monta, y /api/docs responde como ruta inexistente.
# DOCS_ENABLED=true

# Limite de peticiones, en memoria y sin Redis. Con una sola instancia da igual
# que Redis; con varias, cada una lleva su cuenta y el tope real es
# limite x instancias, asi que habria que bajar el limite al repartir.
# Con RATE_LIMIT_ENABLED=false se apagan todos (lo usan las pruebas automaticas:
# 190 peticiones seguidas contra la API no son un trafico hostil).
# RATE_LIMIT_ENABLED=true
# Peticiones por ventana en toda la API. /api/health y /api/docs estan exentos.
# RATE_LIMIT_MAX=300
# RATE_LIMIT_WINDOW_MINUTES=15
# Intentos FALLIDOS de login por ventana y por email (cuenta IP + email, no solo
# IP: por IP sola un atacante con muchos correos no se frenaria nunca). Los
# accesos correctos no gastan cupo, para que un usuario normal no se bloquee a
# si mismo.
# LOGIN_RATE_LIMIT_MAX=15

# Cuantos proxies hay delante. Con la API detras de un proxy o un balanceador,
# req.ip es la maquina de al lado y todas las peticiones comparten un mismo
# limite: el primero que moleste tumbaria la API entera.
#
# Ponerlo sin que sea verdad es PEOR que no ponerlo: un cliente podria mandar su
# propia cabecera X-Forwarded-For y saltarse el limite falseando esa IP.
# Por defecto 1 con NODE_ENV=production y apagado en desarrollo.
# TRUST_PROXY=1

# Content-Security-Policy. Va laxa a proposito: el frontend es HTML sin build,
# lleva el script embebido y estilos en linea, asi que sin 'unsafe-inline' se
# quedaria en blanco. CSP_ENABLED=false apaga solo la CSP (por ejemplo para
# servir recursos de otro origen); el resto de cabeceras de helmet siguen.
# CSP_ENABLED=true
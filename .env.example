# Base de datos local. La ruta es relativa a la carpeta prisma/:
# file:./dev.db  ->  prisma/dev.db
DATABASE_URL="file:./dev.db"

# Puerto del servidor
PORT=3000

# Secreto de firma del JWT. Si no se define se genera uno y se guarda en
# data/.jwt-secret, para no perder las sesiones al reiniciar.
# JWT_SECRET=cambia-esto-en-produccion

#.NODE_ENV=production

{
  "printWidth": 110,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "es5",
  "bracketSpacing": true,
  "arrowParens": "always",
  "endOfLine": "lf",
  "overrides": [
    {
      "files": ["*.html"],
      "options": { "printWidth": 120 }
    },
    {
      "files": ["*.md"],
      "options": { "printWidth": 100, "proseWrap": "preserve" }
    },
    {
      "files": ["*.json", "*.yml", "*.yaml"],
      "options": { "printWidth": 100 }
    }
  ]
}

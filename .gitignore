# Dependencias
node_modules/

# Entorno: NUNCA se versiona. El `.env.example` es lo que se versiona.
.env
.env.*
!.env.example

# Base de datos SQLite.
#
# El fichero va SIEMPRE fuera del control de versiones: versionarlo hace que cada
# `git checkout` cambie la base de otra persona, y que dos maquinas que "estan en la
# misma rama" tengan datos distintos. La migracion SI se versiona; el fichero, no.
prisma/*.db
prisma/*.db-journal
prisma/*.db-wal
prisma/*.db-shm

# Copias de seguridad (`npm run db:backup`): son datos de clientes, y una copia
# versionada por error es una fuga de datos vestida de repositorio.
backup/

# Artefactos
coverage/
*.log
npm-debug.log*

# Sistema
.DS_Store
Thumbs.db

# Editores. Se versionan las preferences compartidas pero no las locales.
.vscode/*
!.vscode/settings.json
.idea/
*.swp